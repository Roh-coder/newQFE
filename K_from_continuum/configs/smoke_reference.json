{
  "run": {
    "tag": "smoke_reference_run"
  },
  "paths": {
    "results_root": "results",
    "resume": false
  },
  "execution": {
    "n_workers": 1,
    "exe": null,
    "auto_build": true,
    "force_rebuild": false,
    "build_command": ["make"],
    "build_timeout_s": 600
  },
  "reference_family": {
    "sizes": [4, 6, 8],
    "geometry_defaults": {
      "Lx_mult": 1.0,
      "Ly_mult": 1.0,
      "Tx_frac": 0.0,
      "Ty_frac": 0.0
    }
  },
  "reference_couplings": {
    "k3": 1.0,
    "k1_over_k3": 1.0,
    "k2_over_k3": 1.0
  },
  "beta_strategy": {
    "mode": "free_power_continuum",
    "weighted": false,
    "exponent_initial": 1.0,
    "exponent_min": 0.05,
    "exponent_max": 3.0
  },
  "beta_finder": {
    "beta_lo": 0.05,
    "beta_hi": 0.40,
    "n_coarse": 5,
    "n_refine": 2,
    "n_refine2": 2,
    "n_refine3": 2,
    "n_traj_coarse": 8,
    "n_traj_fine": 12,
    "max_shifts": 2,
    "jackknife": false
  },
  "mc": {
    "n_traj": 30,
    "n_skip": 5,
    "n_therm": 20
  },
  "analysis": {
    "k_values": [1, 2, 3],
    "k_denominator": 4,
    "power_fit": {
      "c_min": 0.05,
      "c_max": 3.0,
      "c_initial": 1.0,
      "min_sizes_for_free_C": 3
    },
    "fss_plots": {
      "enabled": true,
      "dpi": 150
    }
  }
}